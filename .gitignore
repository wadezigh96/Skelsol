# Dependencies
node_modules/

# Local environment (may carry RPC API keys; never committed)
.env
.env.*

# Build output
dist/
build/
*.tsbuildinfo
# Stray compiler output inside source trees (a misconfigured tsc run can
# emit these next to the .ts files; they must never be committed)
src/**/*.js
src/**/*.d.ts
src/**/*.js.map
src/**/*.d.ts.map

# Anchor / Solana
target/
test-ledger/
.anchor/
.DS_Store

# NEVER commit keypairs or secrets. A keypair file controls a wallet.
id.json
*-keypair.json
**/*-keypair.json
keypair.json
**/keypair.json
.env
.env.*
!.env.example

# Editor
.vscode/
.idea/
